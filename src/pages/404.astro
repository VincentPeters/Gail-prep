---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Page not found — GAIL Prep">
  <section class="wrap section">
    <h1>404 — page not found</h1>
    <p>That page wandered off. Let’s get you back on track.</p>
    <div class="links">
      <a class="btn btn-primary" href={`${base}/`}>Home</a>
      <a class="btn btn-ghost" href={`${base}/study`}>Study notes</a>
      <a class="btn btn-ghost" href={`${base}/quizzes`}>Quizzes</a>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding: 4rem 0;
    text-align: center;
  }
  .links {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }
</style>
