---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { DOMAINS } from "../../data/domains";
import { FLASHCARDS, flashcardsByDomain } from "../../data";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (p: string) => `${base}${p}`;
---

<BaseLayout title="Flashcards — GAIL Prep" active="flashcards">
  <section class="wrap section">
    <span class="eyebrow">Memorize</span>
    <h1>Flashcards</h1>
    <p class="lead">
      Lock in the terminology and Google Cloud product names. Flip each card, then mark
      it “known” or “still learning” — the deck remembers, so you can focus on what’s left.
    </p>

    <a class="card card-pad mixed-quiz" href={link("/flashcards/all")}>
      <div>
        <span class="pill">All decks</span>
        <h3>Study all {FLASHCARDS.length} cards</h3>
        <p>One combined deck across every domain. Shuffle and filter to the cards you haven’t mastered yet.</p>
      </div>
      <span class="btn btn-primary">Open full deck →</span>
    </a>

    <div class="grid cols-2 quiz-grid">
      {
        DOMAINS.map((d) => (
          <a class="card card-pad quiz-card" href={link(`/flashcards/${d.id}`)} style={`--accent-domain:${d.hex}`}>
            <div class="quiz-card-head">
              <span class="pill dot" style={`--dot:${d.hex}`}>{d.short}</span>
              <span class="quiz-count">{flashcardsByDomain(d.id).length} cards</span>
            </div>
            <h3>{d.title}</h3>
            <span class="quiz-card-cta">Study deck →</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    color: var(--text-muted);
    max-width: 65ch;
    font-size: 1.05rem;
  }
  .section {
    padding: 2rem 0;
  }
  .mixed-quiz {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin: 1.5rem 0;
    background: linear-gradient(120deg, color-mix(in srgb, var(--g-teal) 12%, var(--bg-elevated)), var(--bg-elevated));
    flex-wrap: wrap;
  }
  .mixed-quiz:hover {
    text-decoration: none;
    box-shadow: var(--shadow-lg);
  }
  .mixed-quiz h3 {
    margin: 0.4rem 0 0.3rem;
  }
  .mixed-quiz p {
    margin: 0;
    color: var(--text-muted);
    max-width: 55ch;
  }
  .quiz-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border-top: 3px solid var(--accent-domain);
    transition: transform 0.1s, box-shadow 0.15s;
  }
  .quiz-card:hover {
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }
  .quiz-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .quiz-count {
    font-weight: 700;
    color: var(--accent-domain);
  }
  .quiz-card h3 {
    margin: 0.2rem 0;
    font-size: 1.1rem;
  }
  .quiz-card-cta {
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.92rem;
  }
</style>
