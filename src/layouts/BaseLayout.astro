---
import "../styles/global.css";
import "../styles/widgets.css";

export interface Props {
  title: string;
  description?: string;
  active?: string;
}

const {
  title,
  description = "Free companion learning site for the Google Cloud Generative AI Leader (GAIL) certification: study notes, quizzes, timed mock exams, and flashcards.",
  active = "",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (path: string) => `${base}${path}`;

const nav = [
  { href: "/", label: "Home", key: "home" },
  { href: "/study", label: "Study", key: "study" },
  { href: "/quizzes", label: "Quizzes", key: "quizzes" },
  { href: "/exam", label: "Mock Exam", key: "exam" },
  { href: "/flashcards", label: "Flashcards", key: "flashcards" },
  { href: "/progress", label: "Progress", key: "progress" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={link("/favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#1a73e8" />
    <!-- Set theme before paint to avoid a flash of the wrong theme -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("gail-theme");
          if (t === "dark" || t === "light") {
            document.documentElement.setAttribute("data-theme", t);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={link("/")}>
          <span class="logo">AI</span>
          <span>GAIL&nbsp;Prep</span>
        </a>
        <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" id="navToggle">☰</button>
        <nav class="nav" id="nav">
          {
            nav.map((item) => (
              <a
                href={link(item.href)}
                aria-current={active === item.key ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode" title="Toggle theme">
            🌗
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <strong>GAIL&nbsp;Prep</strong> — an unofficial, community study companion for the
          Google&nbsp;Cloud Generative&nbsp;AI Leader certification.
        </div>
        <div>
          Not affiliated with or endorsed by Google. Verify exam details on the
          <a href="https://cloud.google.com/learn/certification/generative-ai-leader" target="_blank" rel="noopener">official page</a>.
        </div>
      </div>
    </footer>

    <script is:inline>
      // Theme toggle
      var tt = document.getElementById("themeToggle");
      if (tt) {
        tt.addEventListener("click", function () {
          var root = document.documentElement;
          var current =
            root.getAttribute("data-theme") ||
            (window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          var next = current === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          try {
            localStorage.setItem("gail-theme", next);
          } catch (e) {}
        });
      }
      // Mobile nav
      var nt = document.getElementById("navToggle");
      var nav = document.getElementById("nav");
      if (nt && nav) {
        nt.addEventListener("click", function () {
          var open = nav.classList.toggle("open");
          nt.setAttribute("aria-expanded", open ? "true" : "false");
        });
      }
    </script>
  </body>
</html>
